---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href = "/", class: className = "", ...props } = Astro.props;

// Normalise trailing slashes so "/portfolio/about" and "/portfolio/about/" match
const normalizePath = (path: string) => path.replace(/\/$/, "");

const base = normalizePath(import.meta.env.BASE_URL);
const current = normalizePath(Astro.url.pathname);
const target = normalizePath(href.toString());

// Home only matches exactly; sections also match their sub-pages.
const isActive =
  target === base ? current === target : current.startsWith(target);
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  data-astro-prefetch="load"
  class:list={[
    "relative isolate flex items-center rounded-full px-4 py-2 text-sm font-medium transition-colors duration-200",
    isActive
      ? "text-ctp-crust"
      : "text-ctp-subtext1 hover:text-ctp-text hover:bg-ctp-surface0/60",
    className,
  ]}
  {...props}
>
  {
    isActive && (
      <span
        class="bg-ctp-blue absolute inset-0 -z-10 rounded-full shadow-[0_0_20px_-4px_var(--color-ctp-blue)]"
        aria-hidden="true"
      />
    )
  }
  <slot />
</a>
