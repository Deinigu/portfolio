---
// src/components/SocialLinks.astro
import { socialLinks } from "../consts";
---

<ul class="flex flex-wrap items-center justify-center gap-3">
  {
    socialLinks.map(({ href, label, icon, name }) => {
      const external = href.startsWith("http");
      return (
        <li>
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            aria-label={label}
            title={name}
            class="social glass text-ctp-subtext1 hover:text-ctp-blue grid h-12 w-12 place-items-center rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_30px_-10px_var(--color-ctp-blue)]"
          >
            <span class="h-6 w-6 [&>svg]:h-full [&>svg]:w-full" set:html={icon} />
          </a>
        </li>
      );
    })
  }
</ul>
