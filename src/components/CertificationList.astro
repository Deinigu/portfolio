---
import { certifications } from "../consts";
---

<section aria-labelledby="certs-title" class="py-16">
  <div class="mb-12 text-center">
    <p class="eyebrow mb-3">// 03 — achievements unlocked</p>
    <h2 id="certs-title" class="text-4xl font-bold md:text-5xl">
      Certifications
    </h2>
    <p class="text-ctp-subtext0 mx-auto mt-4 max-w-2xl text-lg">
      Credentials that back up the skills above.
    </p>
  </div>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      certifications.map((cert) => (
        <li class="reveal">
          <a
            href={cert.link}
            target="_blank"
            rel="noopener noreferrer"
            data-tilt
            class="spotlight panel group flex h-full flex-col items-center gap-4 p-6 text-center transition-transform duration-200 ease-out"
            style="--spot-color: var(--color-ctp-yellow)"
          >
            <span class="relative grid h-24 w-24 place-items-center">
              <span
                class="from-ctp-yellow via-ctp-peach to-ctp-yellow absolute inset-0 rounded-full bg-conic opacity-0 blur-md transition-opacity duration-500 group-hover:opacity-70"
                aria-hidden="true"
              />
              <img
                src={cert.imageSrc}
                alt=""
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
                class="relative h-24 w-24 rounded-full object-cover shadow-lg transition-transform duration-500 group-hover:scale-110 group-hover:rotate-[360deg]"
              />
            </span>
            <span class="text-ctp-text text-sm font-semibold">{cert.title}</span>
            <span class="text-ctp-yellow mt-auto font-mono text-xs opacity-70 group-hover:opacity-100">
              🏆 verify ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
