---
import { Image } from "astro:assets";
import {
  collectionMeta,
  formatDate,
  postUrl,
  readingTime,
  type Post,
} from "../scripts/posts";

type Props = { post: Post; featured?: boolean };

const { post, featured = false } = Astro.props;
const meta = collectionMeta[post.collection];
const { title, description, heroImage, tags = [], pubDate } = post.data;
const shownTags = tags.slice(0, 3);
const extraTags = tags.length - shownTags.length;
---

<a
  href={postUrl(post)}
  class:list={[
    "spotlight panel reveal group flex h-full flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl",
    featured && "md:col-span-2 md:flex-row",
  ]}
  style={`--spot-color:${meta.color}; --chip-color:${meta.color}`}
>
  <div
    class:list={[
      "relative overflow-hidden",
      featured ? "aspect-video md:aspect-auto md:w-3/5" : "aspect-video",
    ]}
  >
    {
      heroImage &&
        (typeof heroImage === "string" ? (
          <img
            src={heroImage}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
          />
        ) : (
          <Image
            src={heroImage}
            alt=""
            width={featured ? 900 : 640}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
          />
        ))
    }
    <div
      class="from-ctp-crust/70 absolute inset-0 bg-gradient-to-t via-transparent to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-90"
    >
    </div>
    <span class="chip glass absolute top-3 left-3 !bg-ctp-crust/60">
      <span aria-hidden="true">{meta.icon}</span>
      {meta.label}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5 md:p-6">
    <div class="text-ctp-subtext0 flex items-center gap-2 font-mono text-xs">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h3
      class:list={[
        "group-hover:text-ctp-blue font-bold leading-snug transition-colors",
        featured ? "text-2xl md:text-3xl" : "text-xl",
      ]}
    >
      {title}
    </h3>
    <p class="text-ctp-subtext0 line-clamp-3 text-sm leading-relaxed">
      {description}
    </p>
    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-2">
      {
        shownTags.map((tag) => (
          <span class="chip" style="--chip-color: var(--color-ctp-subtext0)">
            {tag}
          </span>
        ))
      }
      {
        extraTags > 0 && (
          <span class="chip" style="--chip-color: var(--color-ctp-overlay1)">
            +{extraTags}
          </span>
        )
      }
      <span
        class="text-ctp-blue ml-auto -translate-x-2 font-mono text-sm opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
        aria-hidden="true">read →</span
      >
    </div>
  </div>
</a>
