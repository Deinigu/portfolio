---
// Interactive "neural network" particle field. Nodes drift, link up when close
// and are pulled toward the cursor. Colours follow the active Catppuccin theme.
---

<canvas
  id="hero-canvas"
  class="pointer-events-none absolute inset-0 h-full w-full"
  aria-hidden="true"></canvas>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; r: number; c: number };

  let cleanup: (() => void) | undefined;

  function start() {
    cleanup?.();
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mouse = { x: -9999, y: -9999 };
    let nodes: Node[] = [];
    let palette: string[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = true;

    const readPalette = () => {
      const s = getComputedStyle(document.documentElement);
      palette = ["blue", "mauve", "pink", "sky", "lavender"].map((n) =>
        s.getPropertyValue(`--color-ctp-${n}`).trim()
      );
    };

    // Page-relative canvas origin, cached so pointermove never forces layout
    let originX = 0;
    let originY = 0;

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      originX = rect.left + scrollX;
      originY = rect.top + scrollY;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const coarse = matchMedia("(pointer: coarse)").matches;
      const count = Math.round(Math.min(coarse ? 30 : 60, (w * h) / 18000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.8,
        c: Math.floor(Math.random() * 5),
      }));
      if (reduce) draw();
    };

    const LINK = 140;
    const LINK2 = LINK * LINK;
    const MOUSE = 180;
    const MOUSE2 = MOUSE * MOUSE;
    // Lines are grouped into a few opacity levels so each level is a single
    // path + stroke() call, instead of one stroke per line.
    const BUCKETS = 4;
    const buckets: number[][] = Array.from({ length: BUCKETS }, () => []);

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const n of nodes) {
        // Cursor attraction
        const dx = mouse.x - n.x;
        const dy = mouse.y - n.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 40000 && d2 > 1) {
          const d = Math.sqrt(d2);
          n.vx += (dx / d) * 0.02;
          n.vy += (dy / d) * 0.02;
        }
        n.vx *= 0.985;
        n.vy *= 0.985;
        // Keep a little ambient drift
        if (Math.abs(n.vx) < 0.05) n.vx += (Math.random() - 0.5) * 0.05;
        if (Math.abs(n.vy) < 0.05) n.vy += (Math.random() - 0.5) * 0.05;
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }

      for (const b of buckets) b.length = 0;
      const cursorLines: number[] = [];
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK2) {
            // Closer pairs land in brighter buckets
            const level = Math.min(BUCKETS - 1, Math.floor((1 - d2 / LINK2) * BUCKETS));
            buckets[level].push(a.x, a.y, b.x, b.y);
          }
        }
        const mx = a.x - mouse.x;
        const my = a.y - mouse.y;
        if (mx * mx + my * my < MOUSE2) cursorLines.push(a.x, a.y);
      }

      ctx.lineWidth = 0.7;
      ctx.strokeStyle = palette[1];
      for (let l = 0; l < BUCKETS; l++) {
        const segs = buckets[l];
        if (!segs.length) continue;
        ctx.globalAlpha = ((l + 1) / BUCKETS) * 0.45;
        ctx.beginPath();
        for (let k = 0; k < segs.length; k += 4) {
          ctx.moveTo(segs[k], segs[k + 1]);
          ctx.lineTo(segs[k + 2], segs[k + 3]);
        }
        ctx.stroke();
      }
      // Links to the cursor glow brighter
      if (cursorLines.length) {
        ctx.globalAlpha = 0.6;
        ctx.strokeStyle = palette[0];
        ctx.beginPath();
        for (let k = 0; k < cursorLines.length; k += 2) {
          ctx.moveTo(cursorLines[k], cursorLines[k + 1]);
          ctx.lineTo(mouse.x, mouse.y);
        }
        ctx.stroke();
      }

      // Dots, one path per colour
      ctx.globalAlpha = 0.9;
      for (let c = 0; c < palette.length; c++) {
        ctx.fillStyle = palette[c];
        ctx.beginPath();
        for (const n of nodes) {
          if (n.c !== c) continue;
          ctx.moveTo(n.x + n.r, n.y);
          ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        }
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      draw();
      if (visible && !reduce) raf = requestAnimationFrame(loop);
    };

    const onMove = (e: PointerEvent) => {
      mouse.x = e.pageX - originX;
      mouse.y = e.pageY - originY;
    };
    const onLeave = () => {
      mouse.x = mouse.y = -9999;
    };

    readPalette();
    resize();
    loop();

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    // Pause when off-screen to save battery
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) loop();
    });
    io.observe(canvas);
    // Re-read colours when the theme changes
    const mo = new MutationObserver(() => {
      readPalette();
      if (reduce) draw();
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    addEventListener("pointermove", onMove, { passive: true });
    document.documentElement.addEventListener("pointerleave", onLeave);

    cleanup = () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      mo.disconnect();
      removeEventListener("pointermove", onMove);
      document.documentElement.removeEventListener("pointerleave", onLeave);
    };
  }

  document.addEventListener("DOMContentLoaded", start);
</script>
