---
import Card from "./Card.astro";
import { getAllPosts, BASE } from "../scripts/posts";

type Props = { limit?: number };
const { limit = 3 } = Astro.props;

const posts = (await getAllPosts()).slice(0, limit);
---

<section aria-labelledby="recent-title" class="py-16">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow mb-3">// 02 — latest logs</p>
      <h2 id="recent-title" class="text-4xl font-bold md:text-5xl">
        Recent posts
      </h2>
    </div>
    <a
      href={`${BASE}/posts/`}
      class="group text-ctp-blue inline-flex items-center gap-2 font-mono text-sm"
    >
      view all
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  </div>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <Card post={post} />)}
  </div>
</section>
