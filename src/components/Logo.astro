---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import logoPath from "../assets/icon.png";
import { SITE_NAME } from "../consts";

type Props = HTMLAttributes<"a">;
const { href } = Astro.props;
---

<a
  href={href}
  class="group flex items-center gap-2.5 rounded-full py-1 pr-3 pl-1"
  aria-label={`${SITE_NAME} — home`}
>
  <span class="relative grid h-9 w-9 place-items-center">
    <span
      class="from-ctp-blue via-ctp-mauve to-ctp-pink animate-spin-slow absolute inset-0 rounded-full bg-conic opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"></span>
    <Image
      src={logoPath}
      alt=""
      width={72}
      height={72}
      class="relative h-8 w-8 rounded-full transition-transform duration-300 group-hover:scale-90"
    />
  </span>
  <span class="hidden font-mono text-sm font-semibold sm:inline">
    <span class="text-ctp-subtext0">~/</span><span class="text-ctp-text"
      >{SITE_NAME.toLowerCase()}</span
    ><span class="text-ctp-blue animate-pulse">_</span>
  </span>
</a>
