---
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/`, label: "Home" },
  { href: `${base}/about/`, label: "About" },
  { href: `${base}/posts/`, label: "Posts" },
  { href: `${base}/contact/`, label: "Contact" },
];
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-6">
  <nav
    class="glass glass-blur mx-auto flex max-w-5xl items-center justify-between gap-2 rounded-full py-1.5 pr-2 pl-1.5 shadow-lg shadow-black/5"
    aria-label="Main"
  >
    <Logo href={`${base}/`} />

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <HeaderLink href={l.href}>{l.label}</HeaderLink>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-open-palette
        aria-label="Open command palette"
        class="text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0/60 hidden items-center gap-2 rounded-full px-3 py-2 text-sm transition-colors sm:flex"
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
          ></path></svg
        >
        <span>Search</span>
        <kbd class="key">Ctrl K</kbd>
      </button>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="theme-toggle text-ctp-text hover:bg-ctp-surface0/60 grid h-10 w-10 place-items-center rounded-full transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <mask id="moon-mask">
            <rect x="0" y="0" width="100%" height="100%" fill="white"></rect>
            <circle class="moon-cut" cx="24" cy="10" r="6" fill="black"
            ></circle>
          </mask>
          <circle
            class="sun-core"
            cx="12"
            cy="12"
            r="5"
            fill="currentColor"
            mask="url(#moon-mask)"></circle>
          <g class="sun-rays">
            <path
              d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
            ></path>
          </g>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="hover:bg-ctp-surface0/60 grid h-10 w-10 place-items-center rounded-full md:hidden"
      >
        <span class="hamburger relative block h-3.5 w-5" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="glass glass-blur mx-auto mt-2 grid max-w-5xl overflow-hidden rounded-3xl transition-all duration-300 md:hidden"
    data-open="false"
  >
    <ul class="flex min-h-0 flex-col gap-1 p-2">
      {
        links.map((l, i) => (
          <li style={`--i:${i}`}>
            <HeaderLink href={l.href} class="w-full justify-center">
              {l.label}
            </HeaderLink>
          </li>
        ))
      }
      <li style={`--i:${links.length}`}>
        <button
          type="button"
          data-open-palette
          class="text-ctp-subtext0 w-full rounded-full px-4 py-2.5 text-center text-sm"
        >
          Search posts…
        </button>
      </li>
    </ul>
  </div>
</header>

<style>
  #mobile-menu {
    grid-template-rows: 0fr;
    opacity: 0;
    border-width: 0;
  }
  #mobile-menu[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    border-width: 1px;
  }
  #mobile-menu li {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.3s,
      transform 0.3s;
    transition-delay: calc(var(--i) * 40ms);
  }
  #mobile-menu[data-open="true"] li {
    opacity: 1;
    transform: none;
  }

  .hamburger span {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.3s,
      opacity 0.2s,
      top 0.3s;
  }
  .hamburger span:nth-child(1) {
    top: 0;
  }
  .hamburger span:nth-child(2) {
    top: 6px;
  }
  .hamburger span:nth-child(3) {
    top: 12px;
  }
  [aria-expanded="true"] .hamburger span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }
  [aria-expanded="true"] .hamburger span:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .hamburger span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  /* Sun ↔ moon morph */
  .theme-toggle svg {
    transition: transform 0.5s cubic-bezier(0.5, 1.5, 0.5, 1);
  }
  .sun-core {
    transition: r 0.4s;
  }
  .moon-cut {
    transition: cx 0.4s;
  }
  .sun-rays {
    transition:
      opacity 0.3s,
      transform 0.5s;
    transform-origin: center;
  }
  :global(.dark) .theme-toggle svg {
    transform: rotate(-40deg);
  }
  :global(.dark) .sun-core {
    r: 9;
  }
  :global(.dark) .moon-cut {
    cx: 17;
  }
  :global(.dark) .sun-rays {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
</style>

<script>
  const setTheme = (dark: boolean) => {
    document.documentElement.classList.toggle("dark", dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  };

  // Circular reveal from the toggle using the View Transitions API.
  const toggleTheme = (btn: HTMLElement) => {
    const dark = !document.documentElement.classList.contains("dark");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduce) return setTheme(dark);

    const r = btn.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.documentElement.classList.add("theme-transition");
    const vt = document.startViewTransition(() => setTheme(dark));
    vt.ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${radius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 600,
          easing: "cubic-bezier(0.65, 0, 0.35, 1)",
          pseudoElement: "::view-transition-new(root)",
        }
      );
    });
    vt.finished.finally(() =>
      document.documentElement.classList.remove("theme-transition")
    );
  };

  document.addEventListener("DOMContentLoaded", () => {
    const themeBtn = document.getElementById("theme-toggle");
    themeBtn?.addEventListener("click", () => toggleTheme(themeBtn));

    const menuBtn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!menuBtn || !menu) return;
    const setOpen = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menu.dataset.open = String(open);
      menu.inert = !open;
    };
    setOpen(false);
    menuBtn.addEventListener("click", () =>
      setOpen(menu.dataset.open !== "true")
    );
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a, button")) setOpen(false);
    });
  });
</script>
