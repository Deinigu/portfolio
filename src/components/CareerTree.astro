---
import { careerItems } from "../consts";

const typeColor = {
  work: "var(--color-ctp-blue)",
  education: "var(--color-ctp-green)",
  project: "var(--color-ctp-mauve)",
};
const typeIcon = { work: "💼", education: "🎓", project: "🛠️" };
---

<section aria-labelledby="career-title" class="py-16">
  <div class="mb-14 text-center">
    <p class="eyebrow mb-3">// 04 — git log --career</p>
    <h2 id="career-title" class="text-4xl font-bold md:text-5xl">
      Career journey
    </h2>
    <p class="text-ctp-subtext0 mx-auto mt-4 max-w-2xl text-lg">
      The path so far — and the skills picked up along the way.
    </p>
  </div>

  <div class="timeline relative mx-auto max-w-4xl">
    <!-- Track + animated fill -->
    <div
      class="bg-ctp-surface0 absolute top-0 bottom-0 left-4 w-0.5 md:left-1/2 md:-translate-x-1/2"
      aria-hidden="true"
    >
      <div class="timeline-fill from-ctp-blue via-ctp-mauve to-ctp-green h-full w-full origin-top bg-gradient-to-b"></div>
    </div>

    <ol class="relative">
    {
      careerItems.map((item, index) => {
        const left = index % 2 === 0;
        return (
          <li
            class:list={[
              "relative mb-12 flex md:items-center",
              left ? "md:flex-row" : "md:flex-row-reverse",
            ]}
            style={`--c:${typeColor[item.type]}`}
          >
            <span
              class="dot absolute left-4 z-10 mt-6 grid h-9 w-9 -translate-x-1/2 place-items-center rounded-full text-sm md:left-1/2 md:mt-0"
              aria-hidden="true"
            >
              {typeIcon[item.type]}
            </span>

            <div class:list={["reveal ml-12 md:ml-0 md:w-1/2", left ? "md:pr-12" : "md:pl-12"]}>
              <div
                class="spotlight panel p-6"
                style={`--spot-color:${typeColor[item.type]}`}
              >
                <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-xs" style="color:var(--c)">
                    {item.period}
                  </span>
                  <span class="chip" style="--chip-color:var(--c)">
                    {item.type}
                  </span>
                </div>
                <h3 class="text-xl font-bold">{item.title}</h3>
                <p class="mb-3 font-medium" style="color:var(--c)">
                  {item.company}
                </p>
                <p class="text-ctp-subtext1 mb-4 leading-relaxed">
                  {item.description}
                </p>
                <ul class="flex flex-wrap gap-1.5">
                  {item.skills.map((skill) => (
                    <li class="chip" style="--chip-color: var(--color-ctp-subtext0)">
                      {skill}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        );
      })
    }
    </ol>
  </div>
</section>

<style>
  .dot {
    background: var(--color-ctp-base);
    border: 2px solid var(--c);
    box-shadow:
      0 0 0 6px color-mix(in oklab, var(--c) 15%, transparent),
      0 0 24px -2px var(--c);
  }
  :global(.dark) .dot {
    background: var(--color-ctp-crust);
  }

  /* The coloured line "draws" itself as you scroll through the timeline */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline {
        view-timeline: --career block;
      }
      .timeline-fill {
        animation: draw linear both;
        animation-timeline: --career;
        animation-range: entry 40% exit 60%;
      }
    }
  }
  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
