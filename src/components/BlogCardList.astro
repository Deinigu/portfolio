---
import Card from "./Card.astro";
import { collectionsKeys } from "../content.config";
import {
  getAllPosts,
  collectionMeta,
  BASE,
  type PostCollection,
} from "../scripts/posts";

type Props = { collection?: string; limit?: number };
const { collection = "", limit } = Astro.props;

const allPosts = await getAllPosts();
const filtered = collection
  ? allPosts.filter((p) => p.collection === collection)
  : allPosts;
const posts = limit ? filtered.slice(0, limit) : filtered;

const tabs = [
  { key: "", label: "All", icon: "✦", count: allPosts.length },
  ...(collectionsKeys as PostCollection[]).map((key) => ({
    key,
    label: collectionMeta[key].label,
    icon: collectionMeta[key].icon,
    count: allPosts.filter((p) => p.collection === key).length,
  })),
];

const meta = collection ? collectionMeta[collection as PostCollection] : null;
---

<section class="py-8">
  <header class="mx-auto mb-10 max-w-2xl text-center">
    <p class="eyebrow mb-3">
      $ ls ./posts{collection && `/${collection}`} — {filtered.length} entries
    </p>
    <h1 class="text-5xl font-bold md:text-6xl">
      {meta ? <span class="gradient-text">{meta.label}</span> : <span class="gradient-text">Posts</span>}
    </h1>
    <p class="text-ctp-subtext0 mt-4 text-lg">
      {
        meta
          ? `${meta.blurb}.`
          : "Write-ups about the things I make: software, games and music."
      }
    </p>
  </header>

  <nav
    aria-label="Filter posts by category"
    class="glass mx-auto mb-12 flex w-fit max-w-full flex-wrap justify-center gap-1 rounded-full p-1.5"
  >
    {
      tabs.map((tab) => {
        const isActive = collection === tab.key;
        return (
          <a
            href={`${BASE}/posts/${tab.key ? `${tab.key}/` : ""}`}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "relative isolate flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-colors",
              isActive
                ? "text-ctp-crust"
                : "text-ctp-subtext1 hover:text-ctp-text hover:bg-ctp-surface0/60",
            ]}
          >
            {isActive && (
              <span
                class="bg-ctp-blue absolute inset-0 -z-10 rounded-full"
                aria-hidden="true"
              />
            )}
            <span aria-hidden="true">{tab.icon}</span>
            {tab.label}
            <span
              class:list={[
                "font-mono text-xs",
                isActive ? "text-ctp-crust/70" : "text-ctp-overlay1",
              ]}
            >
              {tab.count}
            </span>
          </a>
        );
      })
    }
  </nav>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <Card post={post} />)}
  </div>
</section>
