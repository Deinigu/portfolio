---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL_ENCODED, LINKEDIN, socialLinks } from "../consts";

const linkedin = LINKEDIN;
const channels = socialLinks.filter(
  (s) => s.href.startsWith("http") && s !== linkedin,
);
---

<BaseLayout
  title="Contact"
  description="Got a project, a question or just want to say hi? Get in touch."
>
  <section class="mx-auto grid max-w-6xl gap-12 py-8 lg:grid-cols-[1fr_1.2fr] lg:py-16">
    <div class="text-center lg:text-left">
      <p class="eyebrow mb-3">// open a connection</p>
      <h1 class="text-5xl font-bold md:text-6xl">
        Let's <span class="gradient-text">talk</span>.
      </h1>
      <p class="text-ctp-subtext0 mt-5 text-lg">
        Whether you have a question, want to discuss a project, or just want to
        say hello — reach out and I'll get back to you as soon as possible.
      </p>

      <ul class="mt-10 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="spotlight panel group flex items-center gap-4 p-4"
              >
                <span
                  class="text-ctp-subtext1 group-hover:text-ctp-blue grid h-10 w-10 shrink-0 place-items-center transition-colors [&>svg]:h-6 [&>svg]:w-6"
                  set:html={c.icon}
                />
                <span class="min-w-0">
                  <span class="block font-semibold">{c.name}</span>
                  <span class="text-ctp-subtext0 block truncate text-sm">{c.label}</span>
                </span>
                <span class="text-ctp-overlay1 group-hover:text-ctp-blue ml-auto transition-all group-hover:translate-x-1" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative min-w-0">
      <div
        class="from-ctp-blue/30 via-ctp-mauve/20 absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br to-transparent blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div class="glass space-y-8 rounded-3xl p-6 shadow-2xl sm:p-10">
        <div class="text-ctp-subtext0 -mt-1 flex items-center gap-1.5 font-mono text-xs">
          <span class="bg-ctp-red h-2.5 w-2.5 rounded-full"></span>
          <span class="bg-ctp-yellow h-2.5 w-2.5 rounded-full"></span>
          <span class="bg-ctp-green h-2.5 w-2.5 rounded-full"></span>
          <span class="ml-2">contact.md</span>
        </div>

        <div>
          <p class="eyebrow mb-2">// preferred</p>
          <h2 class="text-2xl font-bold">Message me on LinkedIn</h2>
          <p class="text-ctp-subtext0 mt-2">
            The fastest way to reach me, whether it's about a role, a project or
            anything else.
          </p>
          <a
            href={linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary mt-5 w-full !py-4"
          >
            <span class="h-5 w-5 [&>svg]:h-full [&>svg]:w-full" set:html={linkedin.icon} />
            Open LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="text-ctp-overlay1 flex items-center gap-4 font-mono text-xs" aria-hidden="true">
          <span class="bg-ctp-surface1 h-px flex-1"></span>
          or by email
          <span class="bg-ctp-surface1 h-px flex-1"></span>
        </div>

        <div id="email-box" data-email={CONTACT_EMAIL_ENCODED}>
          <button id="email-reveal" type="button" class="btn btn-ghost w-full !py-4">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            Show email address
          </button>
          <div id="email-revealed" class="hidden flex-col gap-2 sm:flex-row sm:items-center">
            <a
              id="email-link"
              class="panel text-ctp-blue min-w-0 flex-1 truncate p-4 text-center font-mono hover:underline"
            ></a>
            <button
              id="email-copy"
              type="button"
              class="btn btn-ghost shrink-0 !py-4"
            >
              Copy
            </button>
          </div>
          <noscript>
            <p class="text-ctp-subtext0 mt-3 text-center text-sm">
              Enable JavaScript to see the email address, or reach me on LinkedIn.
            </p>
          </noscript>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const box = document.getElementById("email-box");
    const reveal = document.getElementById("email-reveal");
    const revealed = document.getElementById("email-revealed");
    const link = document.getElementById("email-link") as HTMLAnchorElement | null;
    const copy = document.getElementById("email-copy");
    if (!box || !reveal || !revealed || !link || !copy) return;

    // Decoded only on click, so the address is never in the page until asked for.
    let address = "";

    reveal.addEventListener("click", () => {
      address = atob((box.dataset.email ?? "").split("").reverse().join(""));
      link.href = `mailto:${address}`;
      link.textContent = address;
      reveal.classList.add("hidden");
      revealed.classList.replace("hidden", "flex");
      // The focused button just disappeared; move focus to the address so
      // keyboard users keep their place and screen readers read it out.
      link.focus();
    });

    copy.addEventListener("click", async () => {
      const toast = (window as any).__toast;
      try {
        await navigator.clipboard.writeText(address);
        toast?.("📋 Email copied");
      } catch {
        toast?.("Couldn't copy — select the address instead");
      }
    });
  });
</script>
