---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../consts";

const channels = socialLinks.filter((s) => s.href.startsWith("http"));
---

<BaseLayout
  title="Contact"
  description="Got a project, a question or just want to say hi? Send me a message."
>
  <section class="mx-auto grid max-w-6xl gap-12 py-8 lg:grid-cols-[1fr_1.2fr] lg:py-16">
    <div class="text-center lg:text-left">
      <p class="eyebrow mb-3">// open a connection</p>
      <h1 class="text-5xl font-bold md:text-6xl">
        Let's <span class="gradient-text">talk</span>.
      </h1>
      <p class="text-ctp-subtext0 mt-5 text-lg">
        Whether you have a question, want to discuss a project, or just want to
        say hello — my inbox is open. I'll get back to you as soon as possible.
      </p>

      <ul class="mt-10 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="spotlight panel group flex items-center gap-4 p-4"
              >
                <span
                  class="text-ctp-subtext1 group-hover:text-ctp-blue grid h-10 w-10 shrink-0 place-items-center transition-colors [&>svg]:h-6 [&>svg]:w-6"
                  set:html={c.icon}
                />
                <span class="min-w-0">
                  <span class="block font-semibold">{c.name}</span>
                  <span class="text-ctp-subtext0 block truncate text-sm">{c.label}</span>
                </span>
                <span class="text-ctp-overlay1 group-hover:text-ctp-blue ml-auto transition-all group-hover:translate-x-1" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <div
        class="from-ctp-blue/30 via-ctp-mauve/20 absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br to-transparent blur-2xl"
        aria-hidden="true"
      >
      </div>
      <form
        action="https://formspree.io/f/mrbknyvw"
        method="POST"
        data-astro-reload
        class="glass space-y-5 rounded-3xl p-6 shadow-2xl sm:p-10"
      >
        <div class="text-ctp-subtext0 -mt-1 mb-2 flex items-center gap-1.5 font-mono text-xs">
          <span class="bg-ctp-red h-2.5 w-2.5 rounded-full"></span>
          <span class="bg-ctp-yellow h-2.5 w-2.5 rounded-full"></span>
          <span class="bg-ctp-green h-2.5 w-2.5 rounded-full"></span>
          <span class="ml-2">new_message.md</span>
        </div>

        <!-- Honeypot: invisible trap for bots -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />

        <div class="field">
          <input type="text" id="name" name="name" required placeholder=" " autocomplete="name" />
          <label for="name">Name</label>
        </div>
        <div class="field">
          <input type="email" id="email" name="email" required placeholder=" " autocomplete="email" />
          <label for="email">Email</label>
        </div>
        <div class="field">
          <textarea id="message" name="message" required rows="6" placeholder=" "></textarea>
          <label for="message">Message</label>
        </div>

        <div class="flex justify-center overflow-hidden py-2">
          <div id="recaptcha" data-sitekey="6LfxFfwrAAAAAJ-2kYG4AZTotzQTu6Tq18NsFOfQ"></div>
        </div>

        <button type="submit" class="btn btn-primary w-full !py-4">
          Send message
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z"></path><path d="M22 2 11 13"></path></svg>
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .field {
    position: relative;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 1.5rem 1rem 0.6rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in oklab, var(--color-ctp-overlay0) 35%, transparent);
    background: color-mix(in oklab, var(--color-ctp-crust) 50%, transparent);
    color: var(--color-ctp-text);
    caret-color: var(--color-ctp-blue);
    outline: none;
    resize: vertical;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-ctp-blue);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-ctp-blue) 20%, transparent);
  }
  .field label {
    position: absolute;
    left: 1rem;
    top: 1.05rem;
    color: var(--color-ctp-subtext0);
    pointer-events: none;
    transform-origin: left top;
    transition:
      transform 0.2s,
      color 0.2s;
  }
  .field :is(input, textarea):focus + label,
  .field :is(input, textarea):not(:placeholder-shown) + label {
    transform: translateY(-0.65rem) scale(0.75);
    color: var(--color-ctp-blue);
    font-family: var(--font-mono);
  }
</style>

<script>
  // Render reCAPTCHA explicitly so it works with client-side navigation and
  // matches the current theme.
  declare global {
    interface Window {
      grecaptcha?: { render: (el: HTMLElement, opts: object) => void };
      __onRecaptcha?: () => void;
    }
  }

  const renderCaptcha = () => {
    const el = document.getElementById("recaptcha");
    if (!el || el.childElementCount || !window.grecaptcha?.render) return;
    window.grecaptcha.render(el, {
      sitekey: el.dataset.sitekey,
      theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
    });
  };

  document.addEventListener("DOMContentLoaded", () => {
    if (!document.getElementById("recaptcha")) return;
    if (window.grecaptcha?.render) return renderCaptcha();
    window.__onRecaptcha = renderCaptcha;
    if (!document.querySelector("script[data-recaptcha]")) {
      const s = document.createElement("script");
      s.src = "https://www.google.com/recaptcha/api.js?onload=__onRecaptcha&render=explicit";
      s.async = true;
      s.dataset.recaptcha = "";
      document.head.appendChild(s);
    }
  });
</script>
