---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCardList from "../../components/BlogCardList.astro";
import { collectionsKeys } from "../../content.config";
import { collectionMeta, type PostCollection } from "../../scripts/posts";

export async function getStaticPaths() {
  return collectionsKeys.map((key) => ({
    params: { collection: key },
  }));
}

const collection = Astro.params.collection as PostCollection;
const meta = collectionMeta[collection];
---

<BaseLayout title={meta.label} description={`${meta.blurb}.`}>
  <BlogCardList collection={collection} />
</BaseLayout>
