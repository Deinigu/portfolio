---
import { render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getAllPosts, readingTime, type Post } from "../../scripts/posts";

export async function getStaticPaths() {
  // Sorted newest → oldest, so neighbours give prev/next navigation.
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: `${post.collection}/${post.id}` },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

type Props = { post: Post; newer?: Post; older?: Post };
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
  post={post}
  headings={headings}
  minutes={readingTime(post.body)}
  newer={newer}
  older={older}
>
  <Content />
</BlogPost>
